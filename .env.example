# FieldOps 360 local Docker credentials.
#
# Do not copy this template directly to .env.
# Start-LocalEnvironment.ps1 automatically generates
# two independent random SQL Server passwords.
#
# Initialize-LocalEnvironment.ps1 can also prepare
# the credentials and local TLS material separately.
#
# Keep the generated .env private.
# Never commit it or replace credentials associated
# with an existing SQL Server data volume.

# Administrative account used for database migrations.
FIELDOPS_SQL_SA_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD

# Restricted application runtime account.
FIELDOPS_SQL_APP_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
